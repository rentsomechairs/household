rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /households/primary-home {
      allow read, create, update: if signedIn();
      allow delete: if false;

      match /configuration/{documentId} {
        allow read, write: if signedIn();
      }

      // Profile names/photos must be readable before a device signs in so the
      // profile picker can appear on new phones and the Echo Show.
      match /members/{memberId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }

      match /events/{eventId} {
        allow read, create, update, delete: if signedIn();
      }
      match /tasks/{taskId} {
        allow read, create, update, delete: if signedIn();
      }
      match /lists/{listId} {
        allow read, create, update, delete: if signedIn();
      }
      match /completions/{completionId} {
        allow read, create, update, delete: if signedIn();
      }

      // A signed-out display may create and watch a one-time approval request.
      // Only a signed-in Google user can approve/update it.
      match /authRequests/{requestId} {
        allow create, read, delete: if true;
        allow update: if signedIn();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
